rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'abdourahmanebathily1@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'phone', 'role', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'phone', 'role', 'status', 'address', 'city', 'createdAt', 'avatarUrl', 'lastLogin'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160
        && data.phone is string && data.phone.size() <= 32
        && data.role in ['user', 'admin', 'manager']
        && data.status in ['active', 'suspended']
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
        && (!data.keys().hasAny(['address']) || (data.address is string && data.address.size() <= 300))
        && (!data.keys().hasAny(['city']) || (data.city is string && data.city.size() <= 120))
        && (!data.keys().hasAny(['avatarUrl']) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!data.keys().hasAny(['lastLogin']) || (data.lastLogin is string && data.lastLogin.size() <= 64));
    }

    function isValidDeletedUser(data) {
      return data.keys().hasAll(['id', 'deletedAt', 'deletedBy', 'authDeleted'])
        && data.keys().hasOnly(['id', 'deletedAt', 'deletedBy', 'authDeleted'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.deletedAt is string && data.deletedAt.size() >= 10 && data.deletedAt.size() <= 64
        && data.deletedBy is string && data.deletedBy.size() >= 1 && data.deletedBy.size() <= 128
        && data.authDeleted is bool;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'category', 'price', 'description', 'shortDescription', 'features', 'images', 'sizes', 'colors', 'inStock', 'stockCount', 'isFeatured', 'isNew', 'rating', 'reviewCount', 'sku'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'category', 'price', 'originalPrice', 'description', 'shortDescription', 'richSections', 'features', 'images', 'sizes', 'colors', 'inStock', 'stockCount', 'isFeatured', 'isNew', 'rating', 'reviewCount', 'sku'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160
        && data.category in ['electronique', 'electromenager', 'vaisselle', 'deco-maison', 'gadgets']
        && data.price is number && data.price >= 0 && data.price <= 50000000
        && (!data.keys().hasAny(['originalPrice']) || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 50000000))
        && data.description is string && data.description.size() <= 5000
        && data.shortDescription is string && data.shortDescription.size() <= 240
        && (!data.keys().hasAny(['richSections']) || (data.richSections is list && data.richSections.size() <= 12 && (data.richSections.size() == 0 || data.richSections[0] is map)))
        && data.features is list && data.features.size() <= 12
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 5 && data.images[0] is string && data.images[0].size() <= 1000
        && data.sizes is list && data.sizes.size() <= 10
        && data.colors is list && data.colors.size() <= 10
        && data.inStock is bool
        && data.stockCount is number && data.stockCount >= 0 && data.stockCount <= 100000
        && data.isFeatured is bool
        && data.isNew is bool
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.reviewCount is number && data.reviewCount >= 0
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64;
    }

    function isValidPromoCode(data) {
      return data.keys().hasAll(['code', 'discountType', 'value', 'description'])
        && data.keys().hasOnly(['code', 'discountType', 'value', 'minOrderAmount', 'description', 'active'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 32
        && data.discountType in ['percentage', 'fixed']
        && data.value is number && data.value > 0 && data.value <= 1000000
        && (!data.keys().hasAny(['minOrderAmount']) || (data.minOrderAmount is number && data.minOrderAmount >= 0))
        && data.description is string && data.description.size() <= 240
        && (!data.keys().hasAny(['active']) || data.active is bool);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'createdAt', 'customer', 'items', 'subtotal', 'discount', 'deliveryFee', 'total', 'status'])
        && data.keys().hasOnly(['id', 'orderNumber', 'userId', 'createdAt', 'customer', 'items', 'subtotal', 'discount', 'deliveryFee', 'total', 'appliedPromo', 'status'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.orderNumber is string && data.orderNumber.matches('^FS-\\d{2}-\\d{4}$')
        && (!data.keys().hasAny(['userId']) || data.userId == null || (data.userId is string && data.userId.size() <= 128))
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
        && data.customer is map
        && data.customer.fullName is string && data.customer.fullName.size() >= 1 && data.customer.fullName.size() <= 160
        && data.customer.phone is string && data.customer.phone.size() >= 7 && data.customer.phone.size() <= 32
        && data.customer.address is string && data.customer.address.size() >= 1 && data.customer.address.size() <= 300
        && data.customer.zoneId is string && data.customer.zoneId.size() >= 1 && data.customer.zoneId.size() <= 64
        && data.customer.paymentMethod in ['wave', 'orange_money', 'cod']
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.subtotal is number && data.subtotal > 0
        && data.discount is number && data.discount >= 0
        && data.deliveryFee is number && data.deliveryFee >= 0
        && data.total is number && data.total > 0
        && (!data.keys().hasAny(['appliedPromo']) || (data.appliedPromo is string && data.appliedPromo.size() <= 32))
        && data.status in ['pending', 'confirmed', 'shipping', 'delivered', 'cancelled'];
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll(['orderNumber', 'orderId', 'status', 'createdAt', 'updatedAt', 'total', 'itemCount', 'paymentMethod', 'zoneName'])
        && data.keys().hasOnly(['orderNumber', 'orderId', 'status', 'createdAt', 'updatedAt', 'total', 'itemCount', 'paymentMethod', 'zoneName'])
        && data.orderNumber is string && data.orderNumber.matches('^FS-\\d{2}-\\d{4}$')
        && data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128
        && data.status in ['pending', 'confirmed', 'shipping', 'delivered', 'cancelled']
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64
        && data.total is number && data.total > 0
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 500
        && data.paymentMethod in ['wave', 'orange_money', 'cod']
        && data.zoneName is string && data.zoneName.size() >= 1 && data.zoneName.size() <= 160;
    }

    // Products collection: public catalog read, admin write
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == productId;
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Promo codes collection: public read for active checkout codes, admin write
    match /promoCodes/{codeId} {
      allow get: if isValidId(codeId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(codeId) && isValidPromoCode(incoming());
      allow delete: if isAdmin() && isValidId(codeId);
    }

    // Admins index collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // Users collection: PII isolated to owner or admin
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) && isValidUser(incoming()) && incoming().id == userId && (
        isAdmin() ||
        (isOwner(userId) &&
         !exists(/databases/$(database)/documents/deletedUsers/$(userId)) &&
         incoming().status == 'active' &&
         (incoming().role == 'user' || (isBootstrappedAdminEmail() && incoming().role == 'admin')))
      );

      allow update: if isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (isOwner(userId) &&
         !exists(/databases/$(database)/documents/deletedUsers/$(userId)) &&
         existing().status == 'active' &&
         incoming().id == existing().id &&
         incoming().email == existing().email &&
         incoming().role == existing().role &&
         incoming().status == existing().status &&
         incoming().createdAt == existing().createdAt &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'city', 'lastLogin', 'avatarUrl']))
      );

      allow delete: if isValidId(userId) && (isAdmin() || isOwner(userId));
    }

    // Revocation tombstones (zero PII): prevent deleted Firebase Auth sessions from recreating deleted user docs
    match /deletedUsers/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && isValidDeletedUser(incoming()) && incoming().id == userId && (isAdmin() || isOwner(userId));
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Orders collection: supports authenticated users and guest checkout, PII restricted on read
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid)
      );

      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);

      allow create: if isValidId(orderId) && isValidOrder(incoming()) && incoming().id == orderId && (
        isAdmin() ||
        (incoming().status == 'pending' &&
         ((!isSignedIn() && (!incoming().keys().hasAny(['userId']) || incoming().userId == null)) ||
          (isSignedIn() && incoming().userId == request.auth.uid)))
      );

      allow update: if isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() ||
        (isSignedIn() &&
         existing().userId == request.auth.uid &&
         existing().status == 'pending' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         incoming().status == 'cancelled')
      );

      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Non-PII public order tracking lookup by exact FS-XX-XXXX order number (no list allowed)
    match /orderTracking/{trackingId} {
      allow get: if isValidId(trackingId);
      allow list: if isAdmin();

      allow create: if isValidId(trackingId) && isValidOrderTracking(incoming()) &&
        incoming().orderNumber == trackingId && (
          isAdmin() ||
          (incoming().status == 'pending' &&
           existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId)))
        );

      allow update: if isValidId(trackingId) && isValidOrderTracking(incoming()) && (
        isAdmin() ||
        (isSignedIn() &&
         existing().status == 'pending' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().status == 'cancelled' &&
         get(/databases/$(database)/documents/orders/$(existing().orderId)).data.userId == request.auth.uid)
      );

      allow delete: if isAdmin() && isValidId(trackingId);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'recipientScope', 'type', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['id', 'recipientScope', 'userId', 'type', 'title', 'message', 'orderNumber', 'orderId', 'read', 'createdAt'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.recipientScope in ['admin', 'user']
        && (!data.keys().hasAny(['userId']) || data.userId == null || (data.userId is string && data.userId.size() <= 128))
        && data.type in ['order_created', 'order_status', 'low_stock', 'system']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && (!data.keys().hasAny(['orderNumber']) || (data.orderNumber is string && data.orderNumber.matches('^FS-\\d{2}-\\d{4}$')))
        && (!data.keys().hasAny(['orderId']) || (data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128))
        && data.read is bool
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64;
    }

    function isValidNotificationSettings(data) {
      return data.keys().hasAll(['id', 'webhookEnabled', 'notifyOnNewOrder', 'notifyOnStatusChange', 'notifyOnLowStock', 'updatedAt'])
        && data.keys().hasOnly(['id', 'webhookEnabled', 'webhookUrl', 'notifyOnNewOrder', 'notifyOnStatusChange', 'notifyOnLowStock', 'updatedAt'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.webhookEnabled is bool
        && (!data.keys().hasAny(['webhookUrl']) || (data.webhookUrl is string && data.webhookUrl.size() <= 500))
        && data.notifyOnNewOrder is bool
        && data.notifyOnStatusChange is bool
        && data.notifyOnLowStock is bool
        && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidCloudinarySettings(data) {
      return data.keys().hasAll(['id', 'cloudName', 'uploadPreset', 'updatedAt'])
        && data.keys().hasOnly(['id', 'cloudName', 'uploadPreset', 'folder', 'updatedAt'])
        && data.id == 'cloudinary'
        && data.cloudName is string && data.cloudName.size() <= 100
        && data.uploadPreset is string && data.uploadPreset.size() <= 120
        && (!data.keys().hasAny(['folder']) || (data.folder is string && data.folder.size() <= 120))
        && data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    // Real-time notifications: strict owner/admin read, atomic order-backed creation
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (
        isAdmin() ||
        (isSignedIn() && existing().recipientScope == 'user' && existing().userId == request.auth.uid)
      );

      allow list: if isAdmin() || (
        isSignedIn() && existing().recipientScope == 'user' && existing().userId == request.auth.uid
      );

      allow create: if isValidId(notificationId) && isValidNotification(incoming()) && incoming().id == notificationId && (
        isAdmin() ||
        (incoming().read == false &&
         incoming().type == 'order_created' &&
         incoming().keys().hasAll(['orderId', 'orderNumber']) &&
         existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
         ((incoming().recipientScope == 'admin' && (!incoming().keys().hasAny(['userId']) || incoming().userId == null)) ||
          (isSignedIn() && incoming().recipientScope == 'user' && incoming().userId == request.auth.uid)))
      );

      allow update: if isValidId(notificationId) && isValidNotification(incoming()) && (
        isAdmin() ||
        (isSignedIn() &&
         existing().recipientScope == 'user' &&
         existing().userId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
         incoming().read == true)
      );

      allow delete: if isValidId(notificationId) && (
        isAdmin() ||
        (isSignedIn() && existing().recipientScope == 'user' && existing().userId == request.auth.uid)
      );
    }

    // Admin-only automation, notification webhook & Cloudinary media settings
    match /settings/{settingId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && incoming().id == settingId && (
        (settingId == 'notifications' && isValidNotificationSettings(incoming())) ||
        (settingId == 'cloudinary' && isValidCloudinarySettings(incoming()))
      );
      allow delete: if isAdmin() && isValidId(settingId);
    }
  }
}
