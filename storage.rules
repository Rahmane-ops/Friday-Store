rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Product images uploaded by Friday Store Admins
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'abdourahmanebathily1@gmail.com' ||
          firestore.exists(/databases/ai-studio-fridaystorebouti-8f2acc1b-4f35-4eb3-a01f-dc02d0218499/documents/admins/$(request.auth.uid))
        )
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
